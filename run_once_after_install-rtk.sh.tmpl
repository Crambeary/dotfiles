#!/bin/bash
# Installs rtk (Rust Token Killer), the token-reducing CLI proxy that Claude
# Code's PreToolUse hook chain shells out to. Best-effort, like the ccusage
# script: a machine without a usable package manager just doesn't get rtk, and
# everything degrades to plain unfiltered command output.
#
# Deliberately NOT `cargo install rtk`. A different crate also answers to that
# name (reachingforthejack/rtk, "Rust Type Kit"), so cargo would silently
# install the wrong binary — the same collision ~/.claude/RTK.md warns about.
# The verify step below catches it either way by probing for `rtk gain`, which
# only the Token Killer has.
set -uo pipefail

verify() {
  # `rtk gain` exists only in the Token Killer, so it distinguishes this rtk
  # from the same-named Rust Type Kit.
  if rtk gain >/dev/null 2>&1; then
    echo "rtk: verified ($(rtk --version 2>/dev/null))"
    return 0
  fi
  echo "rtk: WRONG BINARY on PATH at $(command -v rtk) — 'rtk gain' failed." >&2
  echo "rtk: this is probably reachingforthejack/rtk (Rust Type Kit)." >&2
  echo "rtk: remove it, then re-run 'chezmoi apply'." >&2
  return 1
}

if command -v rtk >/dev/null 2>&1; then
  verify || exit 0
  exit 0
fi

{{ if eq .chezmoi.os "windows" -}}
# Install the official x64 release instead of `cargo install rtk`, which
# resolves to the unrelated reachingforthejack/rtk crate.
echo "rtk: installing the latest official Windows release"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '
  $ErrorActionPreference = "Stop"
  $release = Invoke-RestMethod -Uri "https://api.github.com/repos/rtk-ai/rtk/releases/latest"
  $asset = $release.assets | Where-Object { $_.name -eq "rtk-x86_64-pc-windows-msvc.zip" } | Select-Object -First 1
  if ($null -eq $asset) { throw "RTK Windows x64 release asset was not found" }
  $binDir = Join-Path $env:USERPROFILE ".local\\bin"
  $zip = Join-Path $env:TEMP $asset.name
  $extractDir = Join-Path $env:TEMP ("rtk-" + $release.tag_name)
  New-Item -ItemType Directory -Force -Path $binDir | Out-Null
  Invoke-WebRequest -Uri $asset.browser_download_url -OutFile $zip
  Expand-Archive -LiteralPath $zip -DestinationPath $extractDir -Force
  $binary = Get-ChildItem -LiteralPath $extractDir -Filter "rtk.exe" -Recurse | Select-Object -First 1 -ExpandProperty FullName
  if ($null -eq $binary) { throw "rtk.exe was not found in the downloaded release" }
  Move-Item -LiteralPath $binary -Destination (Join-Path $binDir "rtk.exe") -Force
  $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
  if (($userPath -split ";") -notcontains $binDir) {
    [Environment]::SetEnvironmentVariable("Path", (($userPath.TrimEnd(";") + ";" + $binDir).TrimStart(";")), "User")
  }
  & (Join-Path $binDir "rtk.exe") --version
  & (Join-Path $binDir "rtk.exe") gain | Out-Null
'
{{- else -}}
if ! command -v brew >/dev/null 2>&1; then
  echo "rtk: Homebrew not found — skipping (bash output stays unfiltered)." >&2
  exit 0
fi

echo "rtk: installing via Homebrew (homebrew/core)"
if ! brew install rtk; then
  echo "rtk: install failed — skipping (bash output stays unfiltered)." >&2
  exit 0
fi

verify || exit 0
{{- end }}
