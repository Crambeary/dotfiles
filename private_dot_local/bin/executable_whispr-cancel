#!/usr/bin/env node
// Cancels an in-progress OpenWhispr dictation on COSMIC.
//
// OpenWhispr's own Escape-to-cancel is a *separate* dynamically-registered
// global shortcut (hotkeyManager slot "cancel"), hit by the same COSMIC
// GlobalShortcuts-portal gap as the main toggle hotkey -- see whispr-toggle.
// Rather than globally capturing Escape in COSMIC (which would swallow it
// for every app, not just during dictation), this sends the exact IPC
// message ("cancel-hotkey-pressed") that OpenWhispr's real Escape handler
// sends: mainWindow.webContents.send("cancel-hotkey-pressed"). The renderer
// only acts on it while actually recording, so it's a no-op otherwise.

const http = require("http");

const INSPECTOR_PORT = 19223;
const MAIN_WINDOW_TITLE = "Voice Recorder"; // set via i18n key window.voiceRecorderTitle

function sendCancel() {
  return new Promise((resolve, reject) => {
    http
      .get(`http://localhost:${INSPECTOR_PORT}/json`, (res) => {
        let data = "";
        res.on("data", (c) => (data += c));
        res.on("end", () => {
          let targets;
          try {
            targets = JSON.parse(data);
          } catch (e) {
            reject(new Error(`bad inspector response: ${e.message}`));
            return;
          }
          if (!targets.length) {
            reject(new Error("no inspector targets -- is OpenWhispr running with --inspect?"));
            return;
          }
          const ws = new WebSocket(targets[0].webSocketDebuggerUrl);
          ws.onopen = () => {
            ws.send(
              JSON.stringify({
                id: 1,
                method: "Runtime.evaluate",
                params: {
                  expression: `
                    (() => {
                      try {
                        const req = process.mainModule.require.bind(process.mainModule);
                        const { BrowserWindow } = req('electron');
                        const w = BrowserWindow.getAllWindows().find(
                          w => w.getTitle() === ${JSON.stringify(MAIN_WINDOW_TITLE)}
                        );
                        if (!w) return 'no-main-window';
                        w.webContents.send('cancel-hotkey-pressed');
                        return 'ok';
                      } catch (e) {
                        return 'error: ' + e.message;
                      }
                    })()
                  `,
                },
              })
            );
          };
          ws.onmessage = (ev) => {
            ws.close();
            resolve(ev.data);
          };
          ws.onerror = (err) => reject(err);
        });
      })
      .on("error", reject);
  });
}

sendCancel()
  .then((result) => {
    let parsed;
    try {
      parsed = JSON.parse(result);
    } catch {
      parsed = result;
    }
    const value = parsed && parsed.result && parsed.result.result && parsed.result.result.value;
    if (value && value !== "ok") {
      process.stderr.write(`whispr-cancel: ${value}\n`);
      process.exit(1);
    }
  })
  .catch((err) => {
    process.stderr.write(`whispr-cancel: ${err.message || err}\n`);
    process.exit(1);
  });
