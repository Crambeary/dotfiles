#!/bin/bash
# Remove a web app desktop launcher created by dms-webapp-install.
# Ported from omarchy's omarchy-webapp-remove (github.com/omacom/omarchy,
# bin/omarchy-webapp-remove), swapping its gum-based picker for a plain
# `select` menu since gum isn't part of this setup.
#
# dms:summary=Remove a web app desktop launcher
# dms:args=[name]
set -e

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="$HOME/.local/share/applications"

# Index launchers by scanning Exec=, so removal deletes the file that was
# found rather than a path rebuilt from the displayed name -- a name with
# characters that don't round-trip cleanly is exactly the case a
# reconstructed path would miss.
WEB_APPS=()
WEB_APP_PATHS=()
while IFS= read -r -d '' file; do
  if grep -q '^Exec=.*dms-launch-webapp.*' "$file"; then
    WEB_APPS+=("$(basename "${file%.desktop}")")
    WEB_APP_PATHS+=("$file")
  fi
done < <(find "$DESKTOP_DIR" -maxdepth 1 -name '*.desktop' -print0 2>/dev/null)

path_for_web_app() {
  local wanted="$1" i
  for i in "${!WEB_APPS[@]}"; do
    if [[ ${WEB_APPS[$i]} == "$wanted" ]]; then
      printf '%s\n' "${WEB_APP_PATHS[$i]}"
      return 0
    fi
  done
}

if (( $# == 0 )); then
  if ((${#WEB_APPS[@]})); then
    mapfile -t SORTED_WEB_APPS < <(printf '%s\n' "${WEB_APPS[@]}" | sort)
    echo "Select a web app to remove:"
    select choice in "${SORTED_WEB_APPS[@]}"; do
      [[ -n $choice ]] && APP_NAME=$choice && break
      echo "Invalid choice."
    done
  else
    echo "No web apps to remove."
    exit 1
  fi
else
  APP_NAME="$*"
fi

if [[ -z ${APP_NAME:-} ]]; then
  echo "You must select a web app to remove."
  exit 1
fi

icon_name=$(printf '%s\n' "$APP_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
desktop_file=$(path_for_web_app "$APP_NAME")
rm -f "${desktop_file:-$DESKTOP_DIR/$APP_NAME.desktop}"
# Icons can carry their source extension (install_user_icon), not just .png.
rm -f "$ICON_DIR/$icon_name".* "$ICON_DIR/$APP_NAME".*

update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
echo "Removed $APP_NAME."
