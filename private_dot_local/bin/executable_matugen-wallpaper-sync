#!/bin/bash
# Retheme kitty/Sketchybar/AeroSpace/Vicinae via matugen whenever the desktop
# wallpaper changes. Run by the com.marctotaro.matugen-wallpaper-sync
# LaunchAgent (Library/LaunchAgents), which uses WatchPaths on
# com.apple.wallpaper's Store/Index.plist -- the only reliable local signal
# for "the wallpaper changed", since matugen's own wallpaper-change
# automation is Linux/NetBSD only.
#
# WatchPaths fires on ANY write to that plist, including ones unrelated to
# the desktop picture (e.g. LastUse timestamps from the idle/screensaver
# wallpaper), so this only re-runs matugen when the resolved image actually
# differs from last time.
set -euo pipefail

export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/Applications/kitty.app/Contents/MacOS:/usr/bin:/bin:$PATH"

CACHE_DIR="$HOME/Library/Caches/matugen-wallpaper-sync"
mkdir -p "$CACHE_DIR"
STATE_FILE="$CACHE_DIR/last-source"
PNG_FILE="$CACHE_DIR/converted.png"
INDEX_PLIST="$HOME/Library/Application Support/com.apple.wallpaper/Store/Index.plist"

# Resolve the current desktop image straight from Index.plist. The earlier
# `System Events` lookup returns '' / 'missing value' when run from launchd.
# Among all displays (and the all-spaces entry), take the Desktop choice with
# the newest LastSet that points at a real file outside our own cache dir
# (so a stale converted image can never become the "source").
source_path="$(/usr/bin/python3 - "$INDEX_PLIST" "$CACHE_DIR" <<'PY'
import os, plistlib, sys, urllib.parse
index, cache = sys.argv[1:3]
with open(index, "rb") as f:
    root = plistlib.load(f)
entries = [root.get("AllSpacesAndDisplays", {})]
entries += root.get("Displays", {}).values()
best = None
for e in entries:
    d = e.get("Desktop") or {}
    content = d.get("Content") or {}
    for choice in content.get("Choices", []):
        if choice.get("Provider") != "com.apple.wallpaper.choice.image":
            continue
        try:
            cfg = plistlib.loads(choice["Configuration"])
            url = cfg["url"]["relative"]
        except Exception:
            continue
        path = urllib.parse.unquote(urllib.parse.urlparse(url).path)
        if path.endswith(".madesktop") and os.path.isfile(path):
            # Built-in Apple wallpapers are a small plist whose
            # thumbnailPath is a decodable HEIC render of the same image.
            try:
                with open(path, "rb") as f:
                    path = plistlib.load(f)["thumbnailPath"]
            except Exception:
                continue
        if not os.path.isfile(path) or path.startswith(cache + "/"):
            continue
        ts = d.get("LastSet")
        if best is None or (ts and ts > best[0]):
            best = (ts, path)
if best:
    print(best[1])
PY
)"

if [[ -z "$source_path" ]]; then
  echo "matugen-wallpaper-sync: no image-file wallpaper found in Index.plist (dynamic/aerial, or wallpaper still points at the cache dir)" >&2
  exit 1
fi

if [[ -f "$STATE_FILE" && "$(cat "$STATE_FILE")" == "$source_path" ]]; then
  exit 0
fi

case "$source_path" in
  *.heic|*.HEIC|*.tiff|*.TIFF)
    # matugen's image decoder doesn't support HEIC/TIFF.
    sips -s format png "$source_path" --out "$PNG_FILE" >/dev/null
    image_path="$PNG_FILE"
    ;;
  *)
    image_path="$source_path"
    ;;
esac

matugen image "$image_path" --source-color-index 0

echo "$source_path" > "$STATE_FILE"
