#!/bin/bash
# Installs a pointer to herdr-app's current skill for Claude Code, Codex
# (~/.agents/skills), and opencode. Read the installed binary's guidance at
# invocation time so app updates do not leave a cached skill behind.
# Best-effort: a machine without herdr-app installed just skips it.
set -uo pipefail

if ! command -v herdr-app >/dev/null 2>&1; then
  echo "herdr-app: not installed — skipping skill install" >&2
  exit 0
fi

skill=$(cat <<'SKILL'
---
name: herdr
description: Control Herdr, a terminal multiplexer for coding agents. Use only when the user explicitly mentions Herdr or asks to use Herdr to inspect or control panes, tabs, workspaces, worktrees, commands, or another agent.
---

# Herdr

Run `herdr-app --skill` and follow its output. It is the current, authoritative
skill for driving Herdr; do not rely on remembered commands.
SKILL
)

for dir in \
  "$HOME/.claude/skills" \
  "$HOME/.agents/skills" \
  "$HOME/.config/opencode/skills"; do
  mkdir -p "$dir/herdr"
  printf '%s\n' "$skill" >"$dir/herdr/SKILL.md"
  echo "herdr-app: installed skill pointer to $dir/herdr"
done
