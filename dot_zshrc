
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
[[ -x /home/linuxbrew/.linuxbrew/bin/brew ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"

# PATH setup moved to the top so it's fully in place even if a later
# block (antidote/compinit/fzf init) stalls and gets Ctrl+C'd.
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

[[ -f ~/.zsh/aliases.zsh ]] && source ~/.zsh/aliases.zsh
[[ -f ~/.zsh/functions.zsh ]] && source ~/.zsh/functions.zsh
[[ -f ~/.zsh/starship.zsh ]] && source ~/.zsh/starship.zsh
[[ -f ~/.zsh/nvm.zsh ]] && source ~/.zsh/nvm.zsh
[[ -f ~/.zsh/wsl2fix.zsh ]] && source ~/.zsh/wsl2fix.zsh
[[ -f ~/.config/secrets/.env ]] && set -a && source ~/.config/secrets/.env
set +a

# Load Starship
eval "$(starship init zsh)"

eval "$(zoxide init zsh)"

export EDITOR=hx
export VISUAL=hx
export HASS_SERVER="http://192.168.1.210"
# sudoplz askpass helper — lets agents run `sudo -A` instead of failing on the password prompt
command -v askpass >/dev/null 2>&1 && export SUDO_ASKPASS="$(command -v askpass)"

HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY

# Vulkan SDK — version is device-specific, so it's pinned per machine in that
# machine's own ~/.config/chezmoi/chezmoi.toml (untracked) rather than here:
#   [data]
#     vulkan_sdk_version = "1.4.350.1"
# `chezmoi init` prompts for it via .chezmoi.toml.tmpl; leave the answer blank
# on machines with no SDK. Machines that skip it get no Vulkan block at all,
# which is what the Linux hosts want — the paths below (and DYLD_LIBRARY_PATH)
# are macOS-only.
#
# Both guards below are load-bearing, and they must stay nested rather than
# collapse into a single `and`:
#   - hasKey: a bare `.vulkan_sdk_version` aborts `chezmoi apply` with "map has
#     no entry for key" on machines that predate the prompt. Go's `and` does not
#     reliably short-circuit, so `and (hasKey . "x") .x` can still hit that.
#   - non-empty: a blank answer is stored as "" rather than omitted, and would
#     otherwise expand to the broken path ~/VulkanSDK//macOS.

# Antidote — static bundle pattern.
# Regenerate the flat bundle only when the plugin list changes, then source it
# directly. Faster than `antidote load` (no subprocess on normal startup) and
# loads plugins deterministically — the dynamic `load` was silently failing to
# initialize zsh-syntax-highlighting (hence: slow startup + no colors).
antidote_src=/opt/homebrew/opt/antidote/share/antidote/antidote.zsh
[[ -f $antidote_src ]] || antidote_src=${ZDOTDIR:-$HOME}/.antidote/antidote.zsh
zsh_plugins=${ZDOTDIR:-$HOME}/.zsh_plugins
if [[ ! ${zsh_plugins}.zsh -nt ${zsh_plugins}.txt ]]; then
  [[ -f $antidote_src ]] && source $antidote_src
  antidote bundle <${zsh_plugins}.txt >|${zsh_plugins}.zsh
fi
source ${zsh_plugins}.zsh

# zsh-vi-mode takes over zle on init and would clobber atuin's keybindings if
# atuin were sourced normally, so its init is deferred via zvm's post-init
# hook instead (see the plugin list for the load-order rationale).
zvm_after_init_commands+=(
  'eval "$(atuin init zsh)"'
)

# Our own completion overrides take precedence over site-functions (fpath
# order determines which same-named function autoload finds first).
fpath=(${ZDOTDIR:-$HOME}/.zsh/completions $fpath)

autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# Modified-arrow word motion. kitty sends the xterm form (CSI 1;3C/D for
# Option, 1;5C/D for Ctrl); zsh binds none of them by default, so it consumes
# the ESC-[ prefix, fails to match, and self-inserts the tail — typing a
# literal ";3D" instead of moving. Terminal.app instead needs its "Use Option
# as Meta key" profile setting, which sends ^[b/^[f (already bound by emacs
# mode). Claude Code's TUI decodes these itself, which is why word motion
# works there and not at the prompt.
bindkey '^[[1;3C' forward-word
bindkey '^[[1;3D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[^?'    backward-kill-word   # Option+Backspace

# fzf shell integration (Ctrl+R history, Ctrl+T file picker, Alt+C cd).
# fzf --zsh requires a recent fzf; distro package layouts vary for older versions.
if (( $+commands[fzf] )); then
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    for fzf_shell_dir in \
      /usr/share/fzf/shell \
      /usr/share/doc/fzf/examples \
      /usr/local/opt/fzf/shell; do
      if [[ -r "$fzf_shell_dir/key-bindings.zsh" ]]; then
        source "$fzf_shell_dir/key-bindings.zsh"
        [[ -r "$fzf_shell_dir/completion.zsh" ]] &&
          source "$fzf_shell_dir/completion.zsh"
        break
      fi
    done
  fi
fi

# opencode — the installer appends a hardcoded absolute path to ~/.zshrc;
# kept portable and guarded so it's a no-op where opencode isn't installed.
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"

# wt (worktree) shell init — was a local edit in ~/.zshrc that never made it
# back into this template; adopted here so `chezmoi apply` stops reverting it.
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# Audio: wine and yabridge (personal Linux machines only)
export WINEESYNC=1
export WINEFSYNC=1
export PATH="$PATH:$HOME/.local/share/yabridge"

# cargo/atuin installers append these unguarded to ~/.zshrc directly; adopted
# here (guarded) so `chezmoi apply` stops reverting them. atuin's own init
# happens above via zvm_after_init_commands instead of a raw eval here, since
# zsh-vi-mode must init first or it clobbers atuin's keybindings.
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
[[ -r "$HOME/.atuin/bin/env" ]] && . "$HOME/.atuin/bin/env"

# atuin's pty-proxy is deliberately NOT initialised here. The atuin installer
# appends `eval "$(atuin pty-proxy init zsh)"` to ~/.zshrc unguarded; if it
# reappears after an atuin upgrade, delete it again rather than re-adopting it.
#
# It wraps the shell in an inner PTY to record scrollback from non-atuin-aware
# TUIs, and that inner PTY does not relay terminal query responses. Anything
# that has to ask the terminal a question breaks: `kitten icat` and yazi's
# image previews fail with "terminal does not support reporting screen sizes
# in pixels" even in a real kitty tab, because the CSI 14 t reply never gets
# back. It also broke herdr pane classification -- pty-proxy execs itself over
# the pane's shell, so the pane tty's foreground process reads as "atuin"
# forever, leaving every pane unknown (empty agent view and snapshot.agents,
# which silenced notify-watch and pick-attention-pane). That case was handled
# with a HERDR_ENV guard before; the terminal-query breakage applies
# everywhere, so the whole thing is gone.
#
# Nothing we use is lost: `atuin init zsh` above handles history and ctrl+r,
# and no output-capture feature is enabled in atuin's config.
