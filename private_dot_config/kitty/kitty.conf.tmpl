{{- if eq .chezmoi.hostname "marc-mac-fedora" -}}
#    __ ___ __  __
#   / //_(_) /_/ /___ __
#  / ,< / / __/ __/ // /
# /_/|_/_/\__/\__/\_, /
#                /___/
#
# Configuration (marc-mac-fedora only — dual-boots KDE and Hyprland/ML4W)
#
# NOTE: kitty.conf has no runtime conditionals, so unlike the zsh/fish configs
# this file cannot branch on the running session. It is tuned for the KDE
# session (the daily driver); the ML4W includes below are made optional so
# they degrade quietly rather than erroring. For true per-session kitty
# config, ML4W's autostart would need to write a session.conf that this file
# includes.
font_family                 JetBrainsMono Nerd Font
font_size                   12
bold_font                   auto
italic_font                 auto
bold_italic_font            auto
remember_window_size        no
initial_window_width        950
initial_window_height       500
cursor_blink_interval       0.5
cursor_stop_blinking_after  1
scrollback_lines            2000
wheel_scroll_min_lines      1
enable_audio_bell           no
window_padding_width        10
# KDE draws real window decorations; hiding them loses the titlebar and
# close button in a Plasma session. Hyprland tiles and doesn't need them,
# so this is the one setting that visibly differs between the two.
hide_window_decorations     no
background_opacity          0.7
dynamic_background_opacity  yes
# -1 warns before closing a window whose tabs have a running process (Claude)
confirm_os_window_close     -1
selection_foreground        none
selection_background        none

# Animated cursor follows text. ML4W-generated, so globinclude rather than
# include: a missing file is skipped silently instead of logging an error.
globinclude $HOME/.config/ml4w/settings/kitty-cursor-trail.conf

# Wallpaper colors, also ML4W-generated (matugen). Under KDE these are
# whatever the last Hyprland wallpaper produced — cosmetic, not broken.
globinclude colors-matugen.conf

# Include Custom Configuration
# Create the file custom.conf in ~/.config/kitty to overwrite the default configuration
include $HOME/.config/kitty/custom.conf
{{- else -}}
# Font Configuration
font_size 12.0
{{ if eq .chezmoi.os "darwin" -}}
font_family      Hack Nerd Font
{{ end -}}

# Window Configuration
window_padding_width 12
{{ if eq .chezmoi.os "darwin" -}}
background_opacity 0.85
background_blur 48
dynamic_background_opacity yes
# Dims unfocused windows (native macOS window blur makes them hard to
# distinguish otherwise)
watcher focus-dim.py
hide_window_decorations titlebar-only
{{- else -}}
background_opacity 0.85
background_blur 32
dynamic_background_opacity yes
hide_window_decorations yes
# NVIDIA's EGL implementation doesn't expose alpha-capable surfaces to
# native Wayland clients, so background_opacity silently renders opaque
# under Hyprland; running through XWayland gives kitty a GLX alpha
# framebuffer that actually blends (confirmed working 2026-08-28).
linux_display_server x11
{{- end }}
# -1 warns before closing a window whose tabs have a running process (Claude)
confirm_os_window_close -1

# Cursor Configuration
cursor_shape block
cursor_blink_interval 1
cursor_trail 1
cursor_trail_decay 0.1 0.4
cursor_trail_start_threshold 2

# Scrollback
scrollback_lines 3000

# Terminal features
copy_on_select yes
strip_trailing_spaces smart

# Key bindings for common actions
map ctrl+shift+n new_window
map ctrl+t new_tab
map ctrl+plus change_font_size all +1.0
map ctrl+minus change_font_size all -1.0
map ctrl+0 change_font_size all 0

# Window Resizing
map ctrl+left resize_window narrower
map ctrl+right resize_window wider
map ctrl+up resize_window taller
map ctrl+down resize_window shorter
# reset all windows in the tab to default sizes
map ctrl+home resize_window reset

# Tab configuration
tab_bar_style powerline
tab_bar_align left

# Shell integration
shell_integration enabled

{{ if eq .chezmoi.os "darwin" -}}
# Matugen generates a Material You palette from the current wallpaper and
# pushes it live via `kitty @ set-colors`; current-theme.conf is kitty's own
# kitten-themes base (Catppuccin-Mocha) so there's always a sane color
# scheme even before matugen has generated anything. globinclude rather than
# include: a missing generated file is skipped silently instead of erroring.
globinclude current-theme.conf
globinclude matugen-theme.conf
{{- else -}}
# Tab/color theme, regenerated by DankMaterialShell from the active
# wallpaper. globinclude so kitty starts cleanly even before DMS has
# generated a theme yet.
globinclude dank-tabs.conf
globinclude dank-theme.conf
{{- end }}
{{- end }}
