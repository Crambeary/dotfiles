[Unit]
Description=Deskflow client (keyboard/mouse from the macOS deskflow server)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# The snap remaps HOME to ~/snap/deskflow/<rev>, so its default settings path is
# revision-numbered and gets orphaned on every refresh. -s pins the config (and
# with it Settings::tlsDir, i.e. tls/deskflow.pem + tls/trusted-servers) to the
# normal XDG location instead.
ExecStart=/snap/bin/deskflow.deskflow-core client -s %h/.config/Deskflow/Deskflow.conf
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
