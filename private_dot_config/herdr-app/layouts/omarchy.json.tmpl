{
  "id": "root",
  "type": "column",
  "floating": [
    { "id": "pane-ops", "content": { "mod": "pane-ops" }, "edge": "bottom", "align": "end" },
    { "id": "screensaver", "content": { "mod": "screensaver" }, "edge": "bottom", "align": "start" },
    {{- /* The Waiting observer: draws nothing, polls pipeline Watches for every mod whatever the sidebar shows. */}}
    { "id": "omarchy-watch", "content": { "mod": "omarchy-watch" }, "edge": "bottom", "align": "end" }{{ if ne .chezmoi.os "windows" }},
    { "id": "herdr-nvim-sync", "content": { "mod": "herdr-nvim", "props": { "role": "sync" } }, "edge": "bottom", "align": "end" }{{ end }}
    {{- /* herdr-chat (macOS only): run_onchange_before_install-herdr-chat installs its mods with --no-layout, and these are
           the two layout edits its installer would make. Each only once its mod is there, so a machine without it keeps a
           working layout; the installer can also leave chat-menu out alone, when Herdr's shipped menu changed shape. */}}
    {{- $mods := joinPath .chezmoi.homeDir ".config/herdr-app/mods" }}
    {{- if and (eq .chezmoi.os "darwin") (stat (joinPath $mods "new-chat/mod.json")) }},
    { "id": "new-chat-commands", "content": { "mod": "new-chat", "props": { "role": "commands" } }, "edge": "bottom", "align": "start" }{{ end }}
  ],{{ if and (eq .chezmoi.os "darwin") (stat (joinPath $mods "chat-menu/mod.json")) }}
  "terminal_menu": "chat-menu",{{ end }}
  "titlebar": "none",
  "traffic_lights": [
    12,
    8
  ],
  "theme": "tokyo-night",
  "font": "CaskaydiaMono Nerd Font",
  "ui_font": "CaskaydiaMono Nerd Font",
  "background": {
    "image": "backgrounds/omarchy/tokyo-night/1-winding-road.webp",
    "fit": "cover"
  },
  "terminal_padding": [
    12,
    12
  ],
  "preview": "layouts/omarchy.svg",
  "resizable": false,
  "children": [
    {
      "id": "topbar",
      "type": "row",
      "size": {
        "px": 30
      },
      "window_drag": true,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "bar-left",
          "type": "block",
          "content": {
            "mod": "omarchy-bar",
            "props": {
              "part": "left"
            }
          },
          "size": {
            "weight": 3
          }
        },
        {
          "id": "review-tools",
          "type": "block",
          "size": {
            "px": 60
          },
          "content": {
            "mod": "omarchy-bar",
            "props": {
              "part": "center"
            }
          }
        },
        {
          "id": "bar-controls",
          "type": "block",
          "size": {
            "weight": 3
          },
          "content": {
            "mod": "omarchy-bar",
            "props": {
              "part": "right"
            }
          }
        }
      ]
    },
    {
      "id": "desk",
      "type": "row",
      "padding": 10,
      "gap": 10,
      "resizable": true,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 243
          },
          "min": 44,
          "max": 480,
          "resizable": false,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "omarchy-spaces"
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            },
            {
              "id": "sidebar-lists",
              "type": "stack",
              "size": {
                "weight": 1
              },
              "min": 90,
              "active": "agents",
              "children": [
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "omarchy-agents"
                  },
                  "background": "chrome",
                  "border": {
                    "width": 2,
                    "color": "border"
                  }
                },
                {
                  "id": "inbox",
                  "type": "block",
                  "content": {
                    "mod": "omarchy-inbox",
                    "props": {
                      "picker": "picker",
                      "newMenu": "new-menu-wt",
                      "openMenu": "omarchy-open"
                    }
                  },
                  "background": "chrome",
                  "border": {
                    "width": 2,
                    "color": "border"
                  }
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": {
                "px": 136
              },
              "content": {
                "mod": "omarchy-chrome",
                "props": {
                  "footer": true
                }
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            }
          ],
          "gap": 10
        },
        {
          "id": "work",
          "type": "column",
          "gap": 10,
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 36
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "content": {
                "mod": "omarchy-tabs"
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "gap": 10,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "omarchy-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 2,
                        "color": "border"
                      },
                      "focus": {
                        "width": 2,
                        "color": "accent"
                      },
                      "radius": 0,
                      "gap": 10,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {{ if eq .chezmoi.os "windows" }}{
                            "mod": "omarchy-files"
                          }{{ else }}{
                            "mod": "herdr-nvim",
                            "props": {
                              "replaces": {
                                "mod": "omarchy-files"
                              }
                            }
                          }{{ end }}
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "{{ if eq .chezmoi.os "windows" }}omarchy-changes{{ else }}gitview{{ end }}"
                          }
                        },
                        {
                          "id": "graph",
                          "type": "block",
                          "content": {
                            "mod": "git-graph"
                          }
                        },
                        {
                          "id": "browser-notes",
                          "type": "block",
                          "content": {
                            "mod": "omarchy-notes"
                          }
                        }
                      ],
                      "active": "changes"
                    }
                  ],
                  "size": {
                    "px": 475
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true,
                  "background": "chrome",
                  "border": {
                    "width": 2,
                    "color": "border"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "forge-sidebar",
          "type": "block",
          "size": { "px": 350 },
          "min": 280,
          "max": 600,
          "hidden": true,
          "background": "chrome",
          "border": { "width": 2, "color": "border" },
          "content": { "mod": "omarchy-forge-sidebar" }
        }
      ]
    },
    {
      "id": "footer",
      "type": "block",
      "size": {
        "px": 30
      },
      "resizable": false,
      "background": "chrome",
      "content": {
        "mod": "omarchy-ai-usage",
        "props": {
          "footer": true
        }
      }
    }
  ]
}
