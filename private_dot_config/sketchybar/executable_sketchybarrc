#!/bin/bash

source "$CONFIG_DIR/colors.sh" # Loads all defined colors
source "$CONFIG_DIR/icons.sh" # Loads all defined icons

ITEM_DIR="$CONFIG_DIR/items" # Directory where the items are configured
PLUGIN_DIR="$CONFIG_DIR/plugins" # Directory where all the plugin scripts are stored

FONT="SF Pro" # Needs to have Regular, Bold, Semibold, Heavy and Black variants
PADDINGS=3 # All paddings use this value (icon, label, background)

# At login, launchd starts sketchybar before AeroSpace's server accepts
# connections, so every `aerospace` query below (and in items/spaces.sh) comes
# back empty and the workspace items are never created. Wait for the server
# instead of racing it; bounded so a missing AeroSpace can't hang the bar.
for _ in $(seq 20); do
  aerospace list-monitors >/dev/null 2>&1 && break
  sleep 1
done

# aerospace setting
AEROSPACE_FOCUSED_MONITOR_NO=$(aerospace list-workspaces --focused)
AEROSPACE_LIST_OF_WINDOWS_IN_FOCUSED_MONITOR=$(aerospace list-windows --workspace $AEROSPACE_FOCUSED_MONITOR_NO | awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')

# Setting up and starting the helper process
HELPER=git.felix.helper
killall helper
(cd $CONFIG_DIR/helper && make)
$CONFIG_DIR/helper/helper $HELPER > /dev/null 2>&1 &

# Unload the macOS on screen indicator overlay for volume change
launchctl unload -F /System/Library/LaunchAgents/com.apple.OSDUIHelper.plist > /dev/null 2>&1 &

# Setting up the general bar appearance of the bar
# Notch handling (built-in display is 1728x1117pt; notch is 32pt tall, 185pt
# wide, centred at x 771-956). macOS reserves that 32pt strip even with the menu
# bar hidden, so a flush bar sized to it costs no usable space.
#   height               - bar height on displays WITHOUT a notch
#   notch_display_height - bar height on the notched display. NOT a gate/filter:
#                          whatever value you set becomes the bar's height there,
#                          so a display-sized value blanks the whole screen.
#   notch_width          - centre region kept free of items
#
# margin/corner_radius start flush (native-display baseline); items/
# display_geometry.sh flips them to a floating look once it detects an
# external monitor attached, since sketchybar has no per-display override for
# those two properties (unlike height/y_offset, which do have notch variants).
bar=(
  height=32
  notch_display_height=32
  color=$BAR_COLOR
  # shadow must stay off: with blur_radius set, the shadow layer gets blurred
  # too and smears a ~15pt haze below the bar, over the top of the tiled
  # windows. Either alone renders clean; together they do not. A flush
  # notch-strip bar has no visible drop shadow to gain anyway.
  shadow=off
  position=top
  sticky=on
  padding_right=10
  padding_left=10
  corner_radius=0
  y_offset=0
  margin=0
  blur_radius=20
  notch_width=200
  topmost=window
)

sketchybar --bar "${bar[@]}"

# Setting up default values
defaults=(
  updates=when_shown
  icon.font="$FONT:Bold:14.0"
  icon.color=$ICON_COLOR
  icon.padding_left=$PADDINGS
  icon.padding_right=$PADDINGS
  label.font="$FONT:Semibold:13.0"
  label.color=$LABEL_COLOR
  label.padding_left=$PADDINGS
  label.padding_right=$PADDINGS
  padding_right=$PADDINGS
  padding_left=$PADDINGS
  background.height=30
  background.corner_radius=9
  popup.background.border_width=2
  popup.background.corner_radius=9
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.color=$POPUP_BACKGROUND_COLOR
  popup.blur_radius=20
  popup.background.shadow.drawing=on
  scroll_texts=on

)

sketchybar --default "${defaults[@]}"


# Left
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"
#source "$ITEM_DIR/yabai.sh"

# Center
# source "$ITEM_DIR/spotify.sh"
# source "$ITEM_DIR/media.sh"

# Right
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/meetingbar.sh"
source "$ITEM_DIR/forticlient.sh"
source "$ITEM_DIR/focus.sh"
source "$ITEM_DIR/display_geometry.sh"
# source "$ITEM_DIR/input_source.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/brew.sh"
#source "$ITEM_DIR/github.sh"
# wifi.sh / svim.sh do not exist in $ITEM_DIR; these sources failed silently.
#source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/volume.sh"
#source "$ITEM_DIR/svim.sh"

source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/weather.sh"

sketchybar --hotload on

# Forcing all item scripts to run (never do this outside of sketchybarrc)
sketchybar --update

# Prime status items immediately; their normal update frequencies take over after startup.
NAME=forticlient "$PLUGIN_DIR/forticlient.sh" &
NAME=meetingbar "$PLUGIN_DIR/meetingbar.sh" &

echo "sketchybar configuation loaded.."
