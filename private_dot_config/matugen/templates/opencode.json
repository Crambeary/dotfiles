{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "{{colors.surface.default.hex}}",
    "backgroundPanel": "{{colors.surface_container_low.default.hex}}",
    "backgroundElement": "{{colors.surface_container.default.hex}}",
    "border": "{{colors.outline_variant.default.hex}}",
    "borderActive": "{{colors.outline.default.hex}}",
    "text": "{{colors.on_surface.default.hex}}",
    "textMuted": "{{colors.on_surface_variant.default.hex}}",
    "primary": "{{colors.primary.default.hex}}",
    "secondary": "{{colors.secondary.default.hex}}",
    "accent": "{{colors.tertiary.default.hex}}",
    "error": "{{colors.error.default.hex}}"
  },
  "theme": {
    "primary": { "dark": "primary", "light": "primary" },
    "secondary": { "dark": "secondary", "light": "secondary" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "error", "light": "error" },
    "warning": { "dark": "accent", "light": "accent" },
    "success": { "dark": "primary", "light": "primary" },
    "info": { "dark": "secondary", "light": "secondary" },
    "text": { "dark": "text", "light": "text" },
    "textMuted": { "dark": "textMuted", "light": "textMuted" },
    "background": { "dark": "background", "light": "background" },
    "backgroundPanel": { "dark": "backgroundPanel", "light": "backgroundPanel" },
    "backgroundElement": { "dark": "backgroundElement", "light": "backgroundElement" },
    "border": { "dark": "border", "light": "border" },
    "borderActive": { "dark": "borderActive", "light": "borderActive" },
    "borderSubtle": { "dark": "backgroundElement", "light": "backgroundElement" },
    "diffAdded": { "dark": "primary", "light": "primary" },
    "diffRemoved": { "dark": "error", "light": "error" },
    "diffContext": { "dark": "secondary", "light": "secondary" },
    "diffHunkHeader": { "dark": "secondary", "light": "secondary" },
    "diffHighlightAdded": { "dark": "primary", "light": "primary" },
    "diffHighlightRemoved": { "dark": "error", "light": "error" },
    "diffAddedBg": { "dark": "backgroundElement", "light": "backgroundElement" },
    "diffRemovedBg": { "dark": "backgroundElement", "light": "backgroundElement" },
    "diffContextBg": { "dark": "backgroundPanel", "light": "backgroundPanel" },
    "diffLineNumber": { "dark": "textMuted", "light": "textMuted" },
    "diffAddedLineNumberBg": { "dark": "backgroundElement", "light": "backgroundElement" },
    "diffRemovedLineNumberBg": { "dark": "backgroundElement", "light": "backgroundElement" },
    "markdownText": { "dark": "text", "light": "text" },
    "markdownHeading": { "dark": "accent", "light": "accent" },
    "markdownLink": { "dark": "primary", "light": "primary" },
    "markdownLinkText": { "dark": "secondary", "light": "secondary" },
    "markdownCode": { "dark": "primary", "light": "primary" },
    "markdownBlockQuote": { "dark": "textMuted", "light": "textMuted" },
    "markdownEmph": { "dark": "accent", "light": "accent" },
    "markdownStrong": { "dark": "primary", "light": "primary" },
    "markdownHorizontalRule": { "dark": "border", "light": "border" },
    "markdownListItem": { "dark": "primary", "light": "primary" },
    "markdownListEnumeration": { "dark": "secondary", "light": "secondary" },
    "markdownImage": { "dark": "primary", "light": "primary" },
    "markdownImageText": { "dark": "secondary", "light": "secondary" },
    "markdownCodeBlock": { "dark": "text", "light": "text" },
    "syntaxComment": { "dark": "textMuted", "light": "textMuted" },
    "syntaxKeyword": { "dark": "accent", "light": "accent" },
    "syntaxFunction": { "dark": "primary", "light": "primary" },
    "syntaxVariable": { "dark": "error", "light": "error" },
    "syntaxString": { "dark": "primary", "light": "primary" },
    "syntaxNumber": { "dark": "accent", "light": "accent" },
    "syntaxType": { "dark": "secondary", "light": "secondary" },
    "syntaxOperator": { "dark": "secondary", "light": "secondary" },
    "syntaxPunctuation": { "dark": "text", "light": "text" }
  }
}
