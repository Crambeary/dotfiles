{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "<{colors.on_surface.default.hex}>", "margin": 2 },
  "block_quote": { "color": "<{colors.on_surface_variant.default.hex}>", "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "<{colors.on_surface.default.hex}>", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "<{colors.primary.default.hex}>", "bold": true },
  "h1": { "prefix": "# ", "color": "<{colors.primary.default.hex}>", "bold": true },
  "h2": { "prefix": "## ", "color": "<{colors.primary.default.hex}>", "bold": true },
  "h3": { "prefix": "### ", "color": "<{colors.secondary.default.hex}>", "bold": true },
  "h4": { "prefix": "#### ", "color": "<{colors.tertiary.default.hex}>", "bold": true },
  "h5": { "prefix": "##### ", "color": "<{colors.secondary.default.hex}>", "bold": true },
  "h6": { "prefix": "###### ", "color": "<{colors.on_surface_variant.default.hex}>", "bold": true },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "color": "<{colors.tertiary.default.hex}>", "bold": true },
  "hr": { "color": "<{colors.outline.default.hex}>", "format": "\n--------\n" },
  "item": { "block_prefix": "• ", "color": "<{colors.secondary.default.hex}>" },
  "enumeration": { "block_prefix": ". ", "color": "<{colors.primary.default.hex}>" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "<{colors.primary.default.hex}>", "underline": true },
  "link_text": { "color": "<{colors.secondary.default.hex}>" },
  "image": { "color": "<{colors.primary.default.hex}>", "underline": true },
  "image_text": { "color": "<{colors.secondary.default.hex}>", "format": "Image: {{.text}} →" },
  "code": { "color": "<{colors.secondary.default.hex}>", "background_color": "<{colors.surface_container.default.hex}>" },
  "code_block": {
    "color": "<{colors.tertiary.default.hex}>",
    "margin": 2,
    "chroma": {
      "text": { "color": "<{colors.on_surface.default.hex}>" },
      "error": { "color": "<{colors.on_surface.default.hex}>", "background_color": "<{colors.error.default.hex}>" },
      "comment": { "color": "<{colors.outline.default.hex}>" },
      "comment_preproc": { "color": "<{colors.secondary.default.hex}>" },
      "keyword": { "color": "<{colors.primary.default.hex}>" },
      "keyword_reserved": { "color": "<{colors.primary.default.hex}>" },
      "keyword_namespace": { "color": "<{colors.primary.default.hex}>" },
      "keyword_type": { "color": "<{colors.tertiary.default.hex}>" },
      "operator": { "color": "<{colors.secondary.default.hex}>" },
      "punctuation": { "color": "<{colors.on_surface_variant.default.hex}>" },
      "name": { "color": "<{colors.on_surface.default.hex}>" },
      "name_builtin": { "color": "<{colors.primary.default.hex}>" },
      "name_tag": { "color": "<{colors.error.default.hex}>" },
      "name_attribute": { "color": "<{colors.secondary.default.hex}>" },
      "name_class": { "color": "<{colors.tertiary.default.hex}>" },
      "name_constant": { "color": "<{colors.primary.default.hex}>" },
      "name_decorator": { "color": "<{colors.secondary.default.hex}>" },
      "name_function": { "color": "<{colors.primary.default.hex}>" },
      "literal_string": { "color": "<{colors.secondary.default.hex}>" },
      "literal_string_escape": { "color": "<{colors.tertiary.default.hex}>" },
      "generic_deleted": { "color": "<{colors.error.default.hex}>" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "<{colors.secondary.default.hex}>" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "<{colors.primary.default.hex}>" },
      "background": { "background_color": "<{colors.surface.default.hex}>" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n→ " },
  "html_block": {},
  "html_span": {}
}
