{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 48,
  "control-center-margin-bottom": 16,
  "control-center-margin-right": 16,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 10,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 380,
  "control-center-height": 600,
  "notification-window-width": 300,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "widgets": [
    "buttons-grid#close-row",
    "title",
    "dnd",
    "notifications",
    "buttons-grid#clear-row"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": false
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "buttons-grid#close-row": {
      "actions": [
        {
          "label": "✕",
          "command": "swaync-client -cp",
          "type": "button"
        }
      ]
    },
    "buttons-grid#clear-row": {
      "actions": [
        {
          "label": "Clear All",
          "command": "swaync-client -C -sw",
          "type": "button"
        }
      ]
    }
  }
}
