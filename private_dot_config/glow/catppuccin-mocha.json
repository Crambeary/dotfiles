{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#cdd6f4", "margin": 2 },
  "block_quote": { "color": "#a6adc8", "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#cdd6f4", "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#cba6f7", "bold": true },
  "h1": { "prefix": "# ", "color": "#f5c2e7", "bold": true },
  "h2": { "prefix": "## ", "color": "#cba6f7", "bold": true },
  "h3": { "prefix": "### ", "color": "#89b4fa", "bold": true },
  "h4": { "prefix": "#### ", "color": "#89dceb", "bold": true },
  "h5": { "prefix": "##### ", "color": "#94e2d5", "bold": true },
  "h6": { "prefix": "###### ", "color": "#a6adc8", "bold": true },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "color": "#f9e2af", "bold": true },
  "hr": { "color": "#6c7086", "format": "\n--------\n" },
  "item": { "block_prefix": "• ", "color": "#89dceb" },
  "enumeration": { "block_prefix": ". ", "color": "#89b4fa" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#89b4fa", "underline": true },
  "link_text": { "color": "#89dceb" },
  "image": { "color": "#89b4fa", "underline": true },
  "image_text": { "color": "#89dceb", "format": "Image: {{.text}} →" },
  "code": { "color": "#a6e3a1", "background_color": "#313244" },
  "code_block": {
    "color": "#fab387",
    "margin": 2,
    "chroma": {
      "text": { "color": "#cdd6f4" },
      "error": { "color": "#cdd6f4", "background_color": "#f38ba8" },
      "comment": { "color": "#6c7086" },
      "comment_preproc": { "color": "#94e2d5" },
      "keyword": { "color": "#cba6f7" },
      "keyword_reserved": { "color": "#cba6f7" },
      "keyword_namespace": { "color": "#cba6f7" },
      "keyword_type": { "color": "#f9e2af" },
      "operator": { "color": "#89dceb" },
      "punctuation": { "color": "#bac2de" },
      "name": { "color": "#cdd6f4" },
      "name_builtin": { "color": "#89b4fa" },
      "name_tag": { "color": "#f38ba8" },
      "name_attribute": { "color": "#a6e3a1" },
      "name_class": { "color": "#f9e2af" },
      "name_constant": { "color": "#cba6f7" },
      "name_decorator": { "color": "#a6e3a1" },
      "name_function": { "color": "#89b4fa" },
      "literal_string": { "color": "#a6e3a1" },
      "literal_string_escape": { "color": "#f5c2e7" },
      "generic_deleted": { "color": "#f38ba8" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#a6e3a1" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#cba6f7" },
      "background": { "background_color": "#1e1e2e" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n→ " },
  "html_block": {},
  "html_span": {}
}
