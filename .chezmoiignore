.config/nvim/plugin/packer_compiled.lua

# Generated antidote bundle â€” .zshrc rebuilds it from .zsh_plugins.txt on demand
.zsh_plugins.zsh

# fish-managed universal vars: fish rewrites this itself; tracking it across
# machines just accumulates dead per-host paths. Each machine owns its own.
.config/fish/fish_variables

# Repo docs, not a dotfile target
README.md

# Python bytecode. The prefer-modern-tools hook runs as a script so it never
# generates this on its own, but compiling it in the source dir (e.g. a
# py_compile syntax check) leaves a __pycache__ that chezmoi would otherwise
# happily sync to every machine.
**/__pycache__/**

# Secrets: never let chezmoi track/add this, regardless of `chezmoi add` habits
.config/secrets/**

# CLAUDE.md is now managed by rulesync out of Crambeary/skills, not chezmoi.
# The only CLAUDE.md/AGENTS.md left in this repo should be this repo's own
# project-level file for working on the dotfiles themselves.
.claude/CLAUDE.md

# Mac and Linux only
{{ if eq .chezmoi.os "windows" }}
.config/herdr/**
# Ghostty has no stable Windows build
.config/ghostty/**
{{ end }}

# rtk resolves its config dir per platform (macOS Application Support, XDG on
# Linux, %APPDATA% on Windows) and takes no override env var, so the same
# partial is laid down at three paths and each is gated to its own OS. All
# three render from .chezmoitemplates/rtk-config.toml — edit that, not these.
{{ if ne .chezmoi.os "darwin" }}
Library/Application Support/rtk/**
{{ end }}
{{ if ne .chezmoi.os "linux" }}
.config/rtk/**
{{ end }}

# Windows only. The PowerShell profiles stay tracked in source so Windows
# still gets them â€” they're just not a target anywhere else.
{{ if ne .chezmoi.os "windows" }}
AppData/Roaming/rtk/**
AppData/Roaming/Zellij/**
AppData/*
scoop/*
Documents/WindowsPowerShell/**
Documents/PowerShell/**
install-powershell7.cmd
{{ end }}

# Fish is used in the Linux/WSL environment, not native Windows.
{{ if eq .chezmoi.os "windows" }}
.config/fish/**
.config/zellij/**
{{ end }}


# macOS only files
{{ if ne .chezmoi.os "darwin" }}
.aerospace.toml
.config/sketchybar/**
.config/marcs_sketchybar/**
{{ end }}

# Optional per-machine SketchyBar settings
.config/sketchybar/local.sh

# Karabiner: macOS only, and this mac's live config is the source of truth
{{ if ne .chezmoi.os "darwin" }}
.config/karabiner/**
{{ end }}

# mpv stream listener: runs only on marc-fedora (the SSH host side of the
# RemoteForward tunnel, playing audio streamed back from marc-mac-fedora)
{{ if ne .chezmoi.hostname "marc-fedora" }}
.config/systemd/user/mpv-stream-listen.service
.local/bin/mpv-stream-listen.sh
{{ end }}

# SSH RemoteForward stanza for marc-fedora: only needed on marc-mac-fedora,
# the machine that initiates the connection and listens locally on 6600
{{ if ne .chezmoi.hostname "marc-mac-fedora" }}
.ssh/config.d/chezmoi
{{ end }}

# dnf5 zsh completion override: only where dnf is actually installed
# (Fedora/RHEL-family) — not macOS, not dnf-less Linux like Ubuntu/Debian.
{{ if not (lookPath "dnf") }}
.zsh/completions/_dnf5
{{ end }}

# KDE Plasma (Linux only)
{{ if ne .chezmoi.os "linux" }}
.config/plasma*
.config/kwin*
.config/kde*
.config/kglobalshortcutsrc
.config/kcminputrc
.config/ksplashrc
{{ end }}

# KDE session-state churn (desktop UUIDs, popup geometry px, screen res) -
# not real config, just noise on every login
.config/kwinrc
.config/plasma-org.kde.plasma.desktop-appletsrc

# COSMIC-only: OpenWhispr's global dictation hotkey doesn't work on COSMIC
# (no XDG GlobalShortcuts portal there yet), so these replace it with a
# COSMIC custom-shortcut -> script workaround. Gated on whether this machine
# actually has a COSMIC config dir, not $XDG_CURRENT_DESKTOP -- that env var
# goes stale in long-lived shells/terminals opened before a desktop-switch,
# so a live env check from within a chezmoi-apply shell can't be trusted.
{{ if not (stat (joinPath .chezmoi.homeDir ".config/cosmic")) }}
.config/cosmic/**
.config/open-whispr-flags.conf
.local/bin/whispr-toggle
.local/bin/whispr-cancel
{{ end }}

# sudoplz askpass wrapper: plays a sound before the zenity sudo dialog, then
# execs the real entrypoint. Gated on the sudoplz install actually being
# present rather than on the OS, because the wrapper shadows uv's
# ~/.local/bin/askpass symlink -- deploying it to a machine without sudoplz
# would leave a wrapper exec'ing a path that does not exist and break
# `sudo -A` outright. macOS is excluded by the same check (no uv tool there,
# and paplay is Linux-only anyway).
{{ if not (stat (joinPath .chezmoi.homeDir ".local/share/uv/tools/sudoplz/bin/askpass")) }}
.local/bin/askpass
{{ end }}

# Flow Launcher: search history and per-plugin usage state, not config -
# churns every time it's used, so don't track it at all.
scoop/persist/flow-launcher/**

# GlazeWM error log: just grows forever, not real config.
.glzr/glazewm/errors.log

# Deskflow client unit: only marc-Ubuntu-TPL071 is a client of the mac's
# deskflow server. Tracked because the snap ships no service of its own (the
# old Synergy .deb did), so this file is the whole autostart mechanism -- and
# because -s encodes a non-obvious fix: the snap remaps HOME to
# ~/snap/deskflow/<rev>, so the default config path is revision-numbered and
# orphans itself (along with tls/, which Settings::tlsDir derives from it) on
# every snap refresh. `systemctl --user enable`d: starts at login.
{{ if ne .chezmoi.hostname "marc-Ubuntu-TPL071" }}
.config/systemd/user/deskflow-client.service
{{ end }}

# Deskflow's own config is not tracked anywhere. Of what it needs, remoteHost
# and computerName are facts about one machine pair (an IP on the USB-eth
# subnet and the screen name the mac's server config already lists), and
# everything else I'd have written matches the built-in defaults. tls/ holds
# the client private key plus per-peer trust state re-derived on pairing.
.config/Deskflow/**

# Same class: LastSeenVersion bumps on every Plasma upgrade, and
# plasmanotifyrc only records Seen=true per app that has ever notified.
# Both blocked `chezmoi apply` with a TTY prompt on every run.
.config/plasma-welcomerc
.config/plasmanotifyrc
