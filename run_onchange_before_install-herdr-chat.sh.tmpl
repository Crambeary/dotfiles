{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# herdr-chat (https://github.com/ChmaraX/herdr-chat): a native chat for Pi,
# Claude Code and Codex in the Herdr app. Its own installer does the work: it
# writes chat/config.json with this machine's absolute paths, and copies Herdr's
# shipped agents list and menu into chat-agents and chat-menu, so the mods can't
# be laid down as plain files.
#
# Pinned: the archive is checked against the SHA-256 below, not just against the
# release's own SHA256SUMS. Bump both to update; the changed script runs again.
#
# --no-layout: the two layout edits it would make (chat-menu as terminal_menu,
# the new-chat commands block) are in layouts/omarchy.json.tmpl, which only
# names those mods once they exist. Everything else is the installer's: mods,
# the ⌘I key in keys.json, the hc chat templates, the sub-agents note in
# ~/.claude/CLAUDE.md (and Codex's and Pi's), Pi's lock extension.
#
# A before script, so the mods are there when the layout template looks.
# Best-effort: a machine without Herdr, hc or node skips it. These lines change
# when they appear, so the next apply runs it then:
# herdr app home: {{ if stat (joinPath .chezmoi.homeDir ".config/herdr-app") }}present{{ else }}absent{{ end }}
# herdr app: {{ if or (stat "/Applications/Herdr.app") (stat (joinPath .chezmoi.homeDir "Applications/Herdr.app")) }}present{{ else }}absent{{ end }}
set -euo pipefail

version=0.4.0
sha256=bbdb5343793281306e279a37b8a167b6518364e68919d0a160a8e1bec89dc32a

skip() { echo "herdr-chat: skipped: $*" >&2; exit 0; }
[ -d "$HOME/.config/herdr-app" ] || skip "no ~/.config/herdr-app (start the Herdr app once, then chezmoi apply)"
command -v hc >/dev/null 2>&1 || skip "hc (herdr-core) not on PATH"
command -v node >/dev/null 2>&1 || skip "node not on PATH"

current=$(readlink "$HOME/.local/share/herdr-chat/current" 2>/dev/null || true)
if [ "$current" = "$version" ] && [ -f "$HOME/.config/herdr-app/mods/new-chat/mod.json" ]; then
  echo "herdr-chat: $version already installed"
  exit 0
fi

cache="$HOME/.cache/herdr-chat/$version"
name="herdr-chat-$version.tar.gz"
mkdir -p "$cache"
if [ ! -f "$cache/$name" ] || [ "$(shasum -a 256 "$cache/$name" | cut -d' ' -f1)" != "$sha256" ]; then
  url="https://github.com/ChmaraX/herdr-chat/releases/download/v$version"
  curl -fsSL "$url/$name" -o "$cache/$name"
  curl -fsSL "$url/SHA256SUMS" -o "$cache/SHA256SUMS"
fi
[ "$(shasum -a 256 "$cache/$name" | cut -d' ' -f1)" = "$sha256" ] || { echo "herdr-chat: $name doesn't match the pinned SHA-256; not installed" >&2; exit 1; }

# The installer from inside the checked archive, given that archive (--from), so it neither fetches nor picks a version.
rm -rf "$cache/src" && mkdir -p "$cache/src"
tar -xzf "$cache/$name" -C "$cache/src" "herdr-chat-$version/install.sh"
sh "$cache/src/herdr-chat-$version/install.sh" --app --from "$cache/$name" --no-layout
{{ end -}}
