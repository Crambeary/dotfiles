{
    "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
    "name": "Matugen Dynamic",
    "author": "matugen",
    "themes": [
        {
            "name": "Matugen Dynamic",
            "appearance": "{{mode}}",
            "style": {
                "accents": [
                    "{{colors.primary.default.hex}}",
                    "{{colors.secondary.default.hex}}",
                    "{{colors.tertiary.default.hex}}"
                ],
                "background.appearance": "opaque",
                "border": "{{colors.outline_variant.default.hex}}",
                "border.variant": "{{colors.outline.default.hex}}",
                "border.focused": "{{colors.primary.default.hex}}",
                "border.selected": "{{colors.primary.default.hex}}",
                "border.transparent": null,
                "border.disabled": "{{colors.outline_variant.default.hex}}60",
                "elevated_surface.background": "{{colors.surface_container_high.default.hex}}",
                "surface.background": "{{colors.surface.default.hex}}",
                "background": "{{colors.background.default.hex}}",
                "element.background": "{{colors.surface_container.default.hex}}",
                "element.hover": "{{colors.surface_container_high.default.hex}}",
                "element.active": "{{colors.surface_container_highest.default.hex}}",
                "element.selected": "{{colors.secondary_container.default.hex}}",
                "element.disabled": "{{colors.surface_container.default.hex}}",
                "drop_target.background": "{{colors.primary_container.default.hex}}80",
                "ghost_element.background": null,
                "ghost_element.hover": "{{colors.surface_container.default.hex}}80",
                "ghost_element.active": "{{colors.surface_container_high.default.hex}}",
                "ghost_element.selected": "{{colors.secondary_container.default.hex}}80",
                "ghost_element.disabled": "{{colors.surface_container.default.hex}}60",
                "text": "{{colors.on_background.default.hex}}",
                "text.muted": "{{colors.on_surface_variant.default.hex}}",
                "text.placeholder": "{{colors.on_surface_variant.default.hex}}99",
                "text.disabled": "{{colors.on_background.default.hex}}60",
                "text.accent": "{{colors.primary.default.hex}}",
                "icon": "{{colors.on_background.default.hex}}",
                "icon.muted": "{{colors.on_surface_variant.default.hex}}",
                "icon.disabled": "{{colors.on_background.default.hex}}60",
                "icon.placeholder": "{{colors.on_surface_variant.default.hex}}80",
                "icon.accent": "{{colors.primary.default.hex}}",
                "status_bar.background": "{{colors.background.default.hex}}",
                "title_bar.background": "{{colors.background.default.hex}}",
                "title_bar.inactive_background": "{{colors.background.default.hex}}",
                "toolbar.background": "{{colors.surface.default.hex}}",
                "tab_bar.background": "{{colors.background.default.hex}}",
                "tab.inactive_background": "{{colors.background.default.hex}}",
                "tab.active_background": "{{colors.surface.default.hex}}",
                "search.match_background": "{{colors.tertiary_container.default.hex}}50",
                "search.active_match_background": "{{colors.error.default.hex}}66",
                "panel.background": "{{colors.background.default.hex}}",
                "panel.focused_border": null,
                "pane.focused_border": null,
                "scrollbar.thumb.background": "{{colors.outline.default.hex}}50",
                "scrollbar.thumb.hover_background": "{{colors.outline.default.hex}}80",
                "scrollbar.thumb.border": "{{colors.outline_variant.default.hex}}40",
                "scrollbar.track.background": null,
                "scrollbar.track.border": "{{colors.outline_variant.default.hex}}20",
