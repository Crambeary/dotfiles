                "modified.border": "{{colors.tertiary_container.default.hex}}",
                "predictive": "{{colors.on_surface_variant.default.hex}}80",
                "predictive.border": "{{colors.outline.default.hex}}",
                "predictive.background": "{{colors.surface_container_highest.default.hex}}80",
                "renamed": "{{colors.primary.default.hex}}",
                "renamed.border": "{{colors.primary.default.hex}}",
                "renamed.background": "{{colors.primary.default.hex}}1A",
                "success": "{{colors.tertiary.default.hex}}",
                "success.background": "{{colors.tertiary.default.hex}}1A",
                "success.border": "{{colors.tertiary.default.hex}}",
