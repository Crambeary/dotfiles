                "editor.background": "{{colors.surface.default.hex}}",
                "editor.gutter.background": "{{colors.surface.default.hex}}",
                "editor.subheader.background": "{{colors.surface.default.hex}}",
                "editor.indent_guide": "{{colors.outline_variant.default.hex}}22",
                "editor.indent_guide_active": "{{colors.primary.default.hex}}99",
