                "terminal.ansi.bright_green": "{{colors.tertiary.default.hex}}",
                "terminal.ansi.dim_green": "{{colors.tertiary.default.hex}}",
                "terminal.ansi.yellow": "{{colors.tertiary_container.default.hex}}",
                "terminal.ansi.bright_yellow": "{{colors.tertiary_container.default.hex}}",
                "terminal.ansi.dim_yellow": "{{colors.tertiary_container.default.hex}}",
                "terminal.ansi.blue": "{{colors.primary.default.hex}}",
                "terminal.ansi.bright_blue": "{{colors.primary.default.hex}}",
                "terminal.ansi.dim_blue": "{{colors.primary.default.hex}}",
                "terminal.ansi.magenta": "{{colors.secondary.default.hex}}",
                "terminal.ansi.bright_magenta": "{{colors.secondary.default.hex}}",
                "terminal.ansi.dim_magenta": "{{colors.secondary.default.hex}}",
                "terminal.ansi.cyan": "{{colors.secondary_container.default.hex}}",
                "terminal.ansi.bright_cyan": "{{colors.secondary_container.default.hex}}",
                "terminal.ansi.dim_cyan": "{{colors.secondary_container.default.hex}}",
                "terminal.ansi.white": "{{colors.on_background.default.hex}}",
                "terminal.ansi.bright_white": "{{colors.on_background.default.hex}}",
                "terminal.ansi.dim_white": "{{colors.on_surface_variant.default.hex}}",
                "link_text.hover": "{{colors.primary.default.hex}}",
                "version_control.added": "{{colors.tertiary.default.hex}}",
                "version_control.modified": "{{colors.tertiary_container.default.hex}}",
                "version_control.word_added": "{{colors.tertiary.default.hex}}33",
                "version_control.word_deleted": "{{colors.error.default.hex}}33",
                "version_control.deleted": "{{colors.error.default.hex}}",
