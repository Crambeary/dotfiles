                "deleted.border": "{{colors.error.default.hex}}",
                "error": "{{colors.error.default.hex}}",
                "error.background": "{{colors.error_container.default.hex}}",
                "error.border": "{{colors.error.default.hex}}",
                "hidden": "{{colors.outline_variant.default.hex}}",
                "hidden.background": "{{colors.outline_variant.default.hex}}1A",
                "hidden.border": "{{colors.outline_variant.default.hex}}60",
                "hint": "{{colors.primary.default.hex}}",
                "hint.background": "{{colors.primary_container.default.hex}}80",
                "hint.border": "{{colors.primary.default.hex}}",
                "ignored": "{{colors.on_surface_variant.default.hex}}60",
                "ignored.background": "{{colors.surface_container.default.hex}}40",
                "ignored.border": "{{colors.outline_variant.default.hex}}40",
