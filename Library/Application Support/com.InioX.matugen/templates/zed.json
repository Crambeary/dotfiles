                    "enum": { "color": "{{colors.primary.default.hex}}", "font_style": null, "font_weight": null },
                    "function": { "color": "{{colors.secondary.default.hex}}", "font_style": null, "font_weight": null },
                    "keyword": { "color": "{{colors.secondary_container.default.hex}}", "font_style": "italic", "font_weight": null },
                    "label": { "color": "{{colors.secondary.default.hex}}", "font_style": null, "font_weight": null },
                    "link_text": { "color": "{{colors.secondary.default.hex}}", "font_style": "italic", "font_weight": null },
                    "link_uri": { "color": "{{colors.primary.default.hex}}", "font_style": "normal", "font_weight": null },
                    "number": { "color": "{{colors.error.default.hex}}", "font_style": null, "font_weight": null },
                    "operator": { "color": "{{colors.primary.default.hex}}", "font_style": null, "font_weight": null },
                    "property": { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": null, "font_weight": null },
                    "punctuation": { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": null, "font_weight": null },
                    "punctuation.bracket": { "color": "{{colors.outline.default.hex}}", "font_style": null, "font_weight": null },
                    "punctuation.delimiter": { "color": "{{colors.outline.default.hex}}", "font_style": null, "font_weight": null },
                    "punctuation.list_marker": { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": null, "font_weight": null },
                    "punctuation.special": { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": null, "font_weight": null },
                    "selector": { "color": "{{colors.tertiary_container.default.hex}}", "font_style": null, "font_weight": null },
                    "selector.pseudo": { "color": "{{colors.secondary.default.hex}}", "font_style": null, "font_weight": null },
                    "string": { "color": "{{colors.tertiary.default.hex}}", "font_style": null, "font_weight": null },
                    "string.escape": { "color": "{{colors.primary.default.hex}}", "font_style": null, "font_weight": null },
                    "string.regex": { "color": "{{colors.tertiary.default.hex}}", "font_style": null, "font_weight": null },
                    "string.special": { "color": "{{colors.primary.default.hex}}", "font_style": null, "font_weight": null },
                    "string.special.symbol": { "color": "{{colors.primary.default.hex}}", "font_style": null, "font_weight": null },
                    "tag": { "color": "{{colors.secondary.default.hex}}", "font_style": null, "font_weight": null },
                    "text.literal": { "color": "{{colors.tertiary.default.hex}}", "font_style": null, "font_weight": null },
                    "title": { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": null, "font_weight": 700 },
                    "type": { "color": "{{colors.tertiary_container.default.hex}}", "font_style": "italic", "font_weight": null },
                    "variable": { "color": "{{colors.on_background.default.hex}}", "font_style": null, "font_weight": null },
                    "variable.special": { "color": "{{colors.error.default.hex}}", "font_style": null, "font_weight": null },
                    "variant": { "color": "{{colors.secondary.default.hex}}", "font_style": null, "font_weight": null }
                }
