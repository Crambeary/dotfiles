                    { "cursor": "{{colors.primary.default.hex}}", "background": "{{colors.primary.default.hex}}80", "selection": "{{colors.primary.default.hex}}3D" },
                    { "cursor": "{{colors.error.default.hex}}", "background": "{{colors.error.default.hex}}80", "selection": "{{colors.error.default.hex}}3D" },
                    { "cursor": "{{colors.tertiary_container.default.hex}}", "background": "{{colors.tertiary_container.default.hex}}80", "selection": "{{colors.tertiary_container.default.hex}}3D" },
                    { "cursor": "{{colors.secondary.default.hex}}", "background": "{{colors.secondary.default.hex}}80", "selection": "{{colors.secondary.default.hex}}3D" },
                    { "cursor": "{{colors.secondary_container.default.hex}}", "background": "{{colors.secondary_container.default.hex}}80", "selection": "{{colors.secondary_container.default.hex}}3D" },
                    { "cursor": "{{colors.tertiary.default.hex}}", "background": "{{colors.tertiary.default.hex}}80", "selection": "{{colors.tertiary.default.hex}}3D" }
                ],
                "syntax": {
                    "attribute": { "color": "{{colors.secondary.default.hex}}", "font_style": "italic", "font_weight": null },
                    "boolean": { "color": "{{colors.error.default.hex}}", "font_style": null, "font_weight": null },
                    "comment": { "color": "{{colors.outline.default.hex}}", "font_style": "italic", "font_weight": null },
                    "comment.doc": { "color": "{{colors.outline.default.hex}}", "font_style": "italic", "font_weight": null },
                    "constant": { "color": "{{colors.error.default.hex}}", "font_style": null, "font_weight": null },
                    "constructor": { "color": "{{colors.secondary.default.hex}}", "font_style": null, "font_weight": null },
                    "embedded": { "color": "{{colors.on_background.default.hex}}", "font_style": null, "font_weight": null },
